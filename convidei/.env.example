# Postgres (Neon). Sem esta variável, o app usa um banco local em .data/ (só para desenvolvimento).
DATABASE_URL=

# Endereço público do app, usado nos links dos convites. Opcional: se vazio, usa o host da requisição.
NEXT_PUBLIC_APP_URL=

# Mercado Pago (Checkout Pro). Sem o token, o botão do Premium só registra o interesse.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (recomendada): rejeita avisos que não vieram do Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=
